# Configuração local de assinatura Release do APK Vyron
# Copie este arquivo para android/keystore.properties (ignorado pelo Git)
# e preencha com os dados da sua keystore permanente.

storeFile=vyron-release.jks
storePassword=SUBSTITUA_PELA_SENHA_DA_KEYSTORE
keyAlias=vyron
keyPassword=SUBSTITUA_PELA_SENHA_DA_CHAVE
